# Copy to deploy/hetzner-demo/.env on the VPS. Keep the real file local and
# mode 600; it contains credentials and is ignored by Git.
APP_ENV=production
REQUIRE_AUTH=true
SESSION_SECRET=replace-with-a-unique-random-value-at-least-32-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters

# DNS A/AAAA record must point at this VPS before Caddy can obtain HTTPS.
PUBLIC_APP_HOST=demo.example.com
PUBLIC_APP_URL=https://demo.example.com
CORS_ORIGINS=https://demo.example.com

POSTGRES_DB=callquanta
POSTGRES_USER=callquanta
POSTGRES_PASSWORD=replace-with-a-unique-database-password
DATABASE_URL=postgresql+psycopg://callquanta:replace-with-a-unique-database-password@postgres:5432/callquanta
REDIS_URL=redis://redis:6379/0

# Use the existing local CTranslate2 model directory, not the parent cache.
# It must contain model.bin, config.json, tokenizer.json and vocabulary.txt.
# This host path is mounted read-only into the STT container.
HOST_FASTER_WHISPER_MODEL_DIR=/absolute/path/to/faster-whisper-small
STT_MODE=faster_whisper
FASTER_WHISPER_MODEL=/models/faster-whisper
FASTER_WHISPER_DEVICE=cpu
FASTER_WHISPER_COMPUTE_TYPE=int8

# QA is external to keep Ollama out of this small-server demo profile.
QA_MODE=openai_compatible
ALLOW_PLACEHOLDER_AI=false
LLM_PROVIDER_CONFIG_SOURCE=db_or_env
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://provider.example/v1
LLM_MODEL=replace-with-provider-model
LLM_API_KEY=replace-with-provider-key
LLM_TIMEOUT_SECONDS=180

# This is a controlled single-workspace demo, not self-service SaaS.
DEMO_CALL_LIMIT=50
MAX_UPLOAD_BYTES_PER_FILE=104857600
MAX_BULK_UPLOAD_BYTES=524288000
RETENTION_AUDIO_DAYS=7
RETENTION_TRANSCRIPTS_DAYS=14
RETENTION_QA_REVIEWS_DAYS=30
RETENTION_INGESTION_EVENTS_DAYS=14
WORKER_HEARTBEAT_SECONDS=30
