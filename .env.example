POSTGRES_DB=callquanta
POSTGRES_USER=callquanta
POSTGRES_PASSWORD=callquanta
DATABASE_URL=postgresql+psycopg://callquanta:callquanta@postgres:5432/callquanta
REDIS_URL=redis://redis:6379/0
API_PORT=8000
WEB_PORT=3000
OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_MODEL=llama3.1:8b

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Placeholder STT is intended only for local development and automated tests.
# Set and verify the real provider mode before a buyer-facing demo or production launch.
STT_MODE=placeholder
FASTER_WHISPER_MODEL=base
FASTER_WHISPER_DEVICE=cpu
FASTER_WHISPER_COMPUTE_TYPE=int8

# Placeholder QA creates deterministic synthetic reviews and must never be mistaken
# for real provider output. Set an explicit real mode before any buyer-facing demo.
QA_MODE=placeholder
ALLOW_PLACEHOLDER_AI=false
QA_QUEUE=qa_jobs
LLM_PROVIDER_CONFIG_SOURCE=env
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://YOUR_WORKSPACE_ID.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.7-flash-2026-07-15
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=180
# External LLM is fail-closed until explicitly enabled. Allowed external
# hosts are restricted to providers used by the CallQuanta integration.
LLM_EXTERNAL_ENABLED=false
LLM_EXTERNAL_ALLOWED_HOSTS=*.ap-southeast-1.maas.aliyuncs.com,generativelanguage.googleapis.com,api.groq.com
LLM_DAILY_CALL_LIMIT=30
LLM_MAX_OUTPUT_TOKENS=1400
LLM_REASONING_EFFORT=low
OLLAMA_KEEP_ALIVE=-1

# Public demo quota. 0 disables the quota. The current implementation is global
# to this deployment; do not treat it as isolated per buyer/workspace.
DEMO_CALL_LIMIT=50

# Telegram Lite adapter. Keep disabled until a real bot token is configured.
# The service token is shared only between the bot container and the API.
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=
LITE_SERVICE_TOKEN=
LITE_API_BASE_URL=http://api:8000
LITE_FREE_ANALYSES=3
LITE_MAX_UPLOAD_BYTES=18874368
LITE_MAX_DURATION_SECONDS=1200
LITE_RETENTION_DAYS=30
LITE_POLL_TIMEOUT_SECONDS=25
LITE_DEFAULT_LANGUAGE=ru
LITE_LIMIT_REACHED_TEXT=

# Telephony recording downloads reject localhost/private IPs and validate every
# redirect by default. Add exact private PBX hostnames only when required.
RECORDING_DOWNLOAD_MAX_BYTES=104857600
RECORDING_DOWNLOAD_TIMEOUT_SECONDS=120
RECORDING_DOWNLOAD_CONNECT_TIMEOUT_SECONDS=10
RECORDING_DOWNLOAD_MAX_REDIRECTS=5
RECORDING_DOWNLOAD_ALLOW_PRIVATE_HOSTS=false
RECORDING_DOWNLOAD_ALLOWED_HOSTS=

# App environment and built-in authentication
APP_ENV=development
REQUIRE_AUTH=true
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional read-only account for an external demo. It can see calls only from
# GUEST_DEMO_TEAM, so reserve that team for synthetic/de-identified examples.
# Never commit a real password into this file.
GUEST_DEMO_EMAIL=
GUEST_DEMO_PASSWORD=
GUEST_DEMO_TEAM=demo
SESSION_SECRET=

# Retention settings; leave empty to keep forever
RETENTION_AUDIO_DAYS=
RETENTION_TRANSCRIPTS_DAYS=
RETENTION_QA_REVIEWS_DAYS=
RETENTION_INGESTION_EVENTS_DAYS=

# Worker status heartbeat cadence
WORKER_HEARTBEAT_SECONDS=30
